[Desktop Entry]
Type=Application
Version=1.5
Name=Niman
GenericName=Markdown Notes
Comment=Markdown notes
Exec=niman %F
Icon=dev.niman.niman
Terminal=false
Categories=Office;TextEditor;Utility;
Keywords=notes;markdown;note;todo;task;list;quick;new;reminder;journal;diary;niman;
StartupWMClass=dev.niman.niman
MimeType=text/markdown;text/x-markdown;
Actions=quick-note;journal-today;new-todo;new-note;new-list;new-voice;

[Desktop Action quick-note]
Name=Quick note
Exec=niman --quick-note

[Desktop Action journal-today]
Name=Today's journal entry
Exec=niman --journal-today

[Desktop Action new-todo]
Name=New todo
Exec=niman --new-todo

[Desktop Action new-note]
Name=New note
Exec=niman --new-note

[Desktop Action new-list]
Name=New list
Exec=niman --new-list

[Desktop Action new-voice]
Name=New voice note
Exec=niman --new-voice
