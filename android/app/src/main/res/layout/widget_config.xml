<?xml version="1.0" encoding="utf-8"?>
<!-- Widget placement screens (round 2, R1/R4): title, optional search,
     the choice list, and an explanatory message with an open-app button
     when there is nothing to choose from. A plain Activity: no engine,
     no Dart at placement time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_config_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/widget_config_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Search notes"
        android:inputType="text"
        android:maxLines="1"
        android:visibility="gone" />

    <ListView
        android:id="@+id/widget_config_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/widget_config_open_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Open Niman"
        android:visibility="gone" />
</LinearLayout>
