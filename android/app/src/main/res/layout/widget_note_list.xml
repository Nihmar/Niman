<?xml version="1.0" encoding="utf-8"?>
<!-- List-note home-screen widget (issue 6): header plus checklist rows,
     drawn exactly like the todo widget (same card, same CheckBox rows).
     RemoteViews only (the launcher inflates this out of process), so
     plain views: no fragments, no custom views, no data binding.
     The rows are a SCROLLABLE ListView backed by a RemoteCollection
     (NoteWidgetService): the launcher binds the service on demand and
     asks for exactly the rows the (resized) widget can show, so a long
     checklist scrolls instead of clipping. The row cap lives in Dart
     (payload size); the empty TextView is the ListView's empty view.
     Row taps flip the item in the background, "+" opens the note's
     add-item field, the header opens the note. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_note_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Quick add: the floating dialog over the launcher where the
             item is typed on the home screen (RemoteViews cannot capture
             typed text). Text, not a drawable, so R8 has nothing new to
             strip. -->
        <TextView
            android:id="@+id/widget_note_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ListView
            android:id="@+id/widget_note_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_note_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
