<?xml version="1.0" encoding="utf-8"?>
<!-- List-note home-screen widget (issue 6): header plus checklist rows,
     drawn exactly like the todo widget (same card, same CheckBox rows).
     RemoteViews only (the launcher inflates this out of process), so
     plain views: no fragments, no custom views, no data binding.
     The rows are 20 STATIC slots, one per payload row (the 20-row cap
     lives in Dart): the launcher reuses the inflated tree between
     updates, so a provider addView would accumulate a copy of the rows
     on every refresh. Each refresh re-fills the slots instead (text,
     color, visibility); unused slots stay gone. Row taps flip the item
     in the background, "+" opens the note's add-item field, the header
     opens the note. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_note_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Quick add: opens the note with its add-item field focused
             (the input field is in the app — RemoteViews cannot capture
             typed text). Text, not a drawable, so R8 has nothing new to
             strip. -->
        <TextView
            android:id="@+id/widget_note_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp" />
    </LinearLayout>

