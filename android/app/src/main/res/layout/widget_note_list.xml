<?xml version="1.0" encoding="utf-8"?>
<!-- List-note home-screen widget (issue 6): header plus checklist rows.
     RemoteViews only (the launcher inflates this out of process), so
     plain views: no fragments, no custom views, no data binding. The
     rows container is filled in-process by the provider (one child per
     payload row); no remote views service, no launcher bind. Row taps
     flip the item in the background, long-press opens the note, "+"
     appends a new empty item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_note_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Background add: appends a new empty item without opening
             the app (the row ops live in Dart, round 2, R4). Text, not
             a drawable, so R8 has nothing new to strip. -->
        <TextView
            android:id="@+id/widget_note_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:id="@+id/widget_note_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_note_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
