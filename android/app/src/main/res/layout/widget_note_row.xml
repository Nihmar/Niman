<?xml version="1.0" encoding="utf-8"?>
<!-- One checklist row of the list-note widget (issue 6): inflated per
     position by NoteWidgetService for the remote collection. The checked
     state is set with setCompoundButtonChecked (on the RemoteViews
     allowlist; a plain setChecked is not). Tapping anywhere on the row
     (checkbox included) flips the item in the background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <CheckBox
        android:id="@+id/widget_note_row_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/widget_note_row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp" />
</LinearLayout>
