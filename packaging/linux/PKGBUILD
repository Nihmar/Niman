# Maintainer: Niman contributors (https://github.com/Nihmar/Niman)
# Arch package for Niman. This is a -bin package: it repacks the prebuilt
# Flutter release tarball published on the GitHub Release page for the same
# version (see README "Release"). There is no AUR upload; the file lives here
# so CI and anyone with the tarball can run `makepkg`.
#
# From a checkout after a release: download
#   niman-${pkgver}-linux-x64.tar.gz
# next to this file and run `makepkg`. In CI the freshly built tarball is
# placed here with the exact name below, so makepkg reuses it instead of
# downloading.
pkgname=niman-bin
pkgver=1.0.0
pkgrel=1
pkgdesc='Niman — multiplatform Markdown note-taking app'
arch=('x86_64')
url='https://github.com/Nihmar/Niman'
license=('MIT')
depends=('gtk3' 'libsecret' 'libayatana-appindicator')
provides=('niman')
conflicts=('niman')
source=("niman-${pkgver}-linux-x64.tar.gz::https://github.com/Nihmar/Niman/releases/download/v${pkgver}/niman-${pkgver}-linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
  install -dm755 "$pkgdir/opt/niman" "$pkgdir/usr/bin" \
    "$pkgdir/usr/share/applications" "$pkgdir/usr/share/pixmaps"
  # The tarball holds the Flutter bundle plus dev.niman.niman.png at root.
  cp -a "$srcdir/bundle/." "$pkgdir/opt/niman/"
  ln -s /opt/niman/niman "$pkgdir/usr/bin/niman"
  install -m644 "$srcdir/dev.niman.niman.png" \
    "$pkgdir/usr/share/pixmaps/dev.niman.niman.png"
  # The desktop entry ships inside the bundle; point it at the install path.
  # The s/// keeps the quick-action flags (--quick-note, ...), fixing only
  # the binary.
  sed -e 's|^Exec=niman |Exec=/usr/bin/niman |' \
    -e 's|^Icon=.*|Icon=dev.niman.niman|' \
    "$srcdir/bundle/dev.niman.niman.desktop" \
    > "$pkgdir/usr/share/applications/dev.niman.niman.desktop"
}
